{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plexusone/systemforge/identity/systemauth/config.schema.json",
  "properties": {
    "issuer": {
      "type": "string",
      "format": "uri",
      "description": "OAuth/OIDC issuer URL"
    },
    "database": {
      "properties": {
        "driver": {
          "type": "string",
          "enum": [
            "postgres",
            "sqlite",
            "mysql"
          ],
          "description": "Database driver"
        },
        "dsn": {
          "type": "string",
          "description": "Database connection string (supports env var expansion)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "driver",
        "dsn"
      ],
      "description": "Database configuration for persistent storage"
    },
    "keys": {
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "RS256",
            "ES256"
          ],
          "description": "JWT signing algorithm",
          "default": "RS256"
        },
        "rotation_days": {
          "type": "integer",
          "minimum": 0,
          "description": "Key rotation interval in days (0 = never)"
        },
        "key_id": {
          "type": "string",
          "description": "JWKS key ID (default: RFC 7638 thumbprint of the key)"
        },
        "verification_keys": {
          "items": {
            "properties": {
              "key_id": {
                "type": "string",
                "description": "Key ID (default: RFC 7638 thumbprint of the key)"
              },
              "public_key_file": {
                "type": "string",
                "description": "Path of the PEM RSA key (supports env var expansion)"
              },
              "public_key_pem": {
                "type": "string",
                "description": "PEM RSA key (supports env var expansion)"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "type": "array",
          "description": "Previous or pre-staged keys published in the JWKS for verification only"
        },
        "private_key_file": {
          "type": "string",
          "description": "Path of the PEM RSA signing key (supports env var expansion)"
        },
        "private_key_pem": {
          "type": "string",
          "description": "PEM RSA signing key"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Signing key configuration"
    },
    "tokens": {
      "properties": {
        "access_token_lifetime": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Access token lifetime (e.g. 10m; at most 15m)",
          "default": "10m",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        },
        "refresh_token_lifetime": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Refresh token lifetime (e.g. 168h",
          "default": "168h",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        },
        "refresh_token_absolute_lifetime": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Absolute lifetime of a refresh-token family across rotations (e.g. 720h)",
          "default": "720h",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        },
        "id_token_lifetime": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "ID token lifetime (e.g. 1h)",
          "default": "1h",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        },
        "auth_code_lifetime": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Authorization code lifetime (e.g. 10m)",
          "default": "10m",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Token lifetime configuration"
    },
    "clients": {
      "items": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique client identifier"
          },
          "secret": {
            "type": "string",
            "description": "Client secret (supports env var expansion)"
          },
          "type": {
            "type": "string",
            "enum": [
              "public",
              "confidential"
            ],
            "description": "Client type"
          },
          "name": {
            "type": "string",
            "description": "Human-readable client name"
          },
          "description": {
            "type": "string",
            "description": "Client description"
          },
          "redirect_uris": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Allowed redirect URIs"
          },
          "grant_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Allowed OAuth grant types"
          },
          "response_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Allowed OAuth response types"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Allowed OAuth scopes"
          },
          "audience": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "Allowed token audiences"
          },
          "access_token_lifetime": {
            "type": "string",
            "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
            "description": "Client-specific access token lifetime; capped at 15m",
            "examples": [
              "15m",
              "1h",
              "168h",
              "720h"
            ]
          },
          "refresh_token_lifetime": {
            "type": "string",
            "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
            "description": "Client-specific refresh token lifetime",
            "examples": [
              "15m",
              "1h",
              "168h",
              "720h"
            ]
          },
          "managed_principals": {
            "type": "boolean",
            "description": "Allow this client to create and sign in managed principals"
          },
          "backchannel_logout_uri": {
            "type": "string",
            "description": "Endpoint for back-channel logout and access-change events"
          },
          "login_token_ttl": {
            "type": "string",
            "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
            "description": "Client-specific default lifetime of reusable login tokens (e.g. 7200h)",
            "examples": [
              "15m",
              "1h",
              "168h",
              "720h"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ]
      },
      "type": "array",
      "description": "Static OAuth client configurations"
    },
    "federation": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable SystemAuth federation"
        },
        "systemauth_url": {
          "type": "string",
          "format": "uri",
          "description": "SystemAuth server URL"
        },
        "app_id": {
          "type": "string",
          "description": "Application ID in the federation"
        },
        "client_id": {
          "type": "string",
          "description": "OAuth client ID for SystemAuth"
        },
        "client_secret": {
          "type": "string",
          "description": "OAuth client secret (supports env var expansion)"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "SystemAuth federation configuration"
    },
    "features": {
      "properties": {
        "require_pkce": {
          "type": "boolean",
          "description": "Require PKCE for authorization code flows",
          "default": true
        },
        "allow_dynamic_registration": {
          "type": "boolean",
          "description": "Enable dynamic client registration (RFC 7591)",
          "default": false
        },
        "enable_device_flow": {
          "type": "boolean",
          "description": "Enable device authorization grant (RFC 8628)",
          "default": false
        },
        "enable_jwt_access_tokens": {
          "type": "boolean",
          "description": "Issue JWT access tokens instead of opaque tokens",
          "default": false
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Feature flags"
    },
    "social_login": {
      "properties": {
        "github": {
          "properties": {
            "client_id": {
              "type": "string",
              "description": "Upstream OAuth client ID (supports env var expansion)"
            },
            "client_secret": {
              "type": "string",
              "description": "Upstream OAuth client secret (supports env var expansion)"
            },
            "redirect_url": {
              "type": "string",
              "format": "uri",
              "description": "Callback URL registered with the provider"
            },
            "scopes": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "Upstream OAuth scopes"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "client_id",
            "client_secret"
          ],
          "description": "GitHub OAuth app credentials"
        },
        "google": {
          "properties": {
            "client_id": {
              "type": "string",
              "description": "Upstream OAuth client ID (supports env var expansion)"
            },
            "client_secret": {
              "type": "string",
              "description": "Upstream OAuth client secret (supports env var expansion)"
            },
            "redirect_url": {
              "type": "string",
              "format": "uri",
              "description": "Callback URL registered with the provider"
            },
            "scopes": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "Upstream OAuth scopes"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "client_id",
            "client_secret"
          ],
          "description": "Google OAuth client credentials"
        },
        "allowed_redirect_origins": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Absolute origins allowed as post-login redirect targets"
        },
        "default_redirect": {
          "type": "string",
          "description": "Post-login redirect when none is requested",
          "default": "/"
        },
        "session_lifetime": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Absolute login session lifetime",
          "default": "12h",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        },
        "skip_consent": {
          "type": "boolean",
          "description": "Auto-grant consent for first-party clients",
          "default": false
        },
        "signup_minimum_age": {
          "type": "integer",
          "maximum": 120,
          "minimum": 0,
          "description": "Minimum age to create an account; 0 asks no age",
          "default": 0
        },
        "insecure_cookies": {
          "type": "boolean",
          "description": "Development only: allow login cookies over plain HTTP",
          "default": false
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Upstream GitHub/Google social login configuration"
    },
    "authz": {
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "rbac",
            "rebac"
          ],
          "description": "Authorization mode: rbac (roles and direct grants) or rebac (relationships evaluated by an engine)",
          "default": "rbac"
        },
        "engine": {
          "type": "string",
          "enum": [
            "spicedb"
          ],
          "description": "Relationship engine for mode rebac (default spicedb)"
        },
        "spicedb": {
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "embedded",
                "remote"
              ],
              "description": "embedded (in process) or remote (gRPC service)",
              "default": "embedded"
            },
            "datastore_engine": {
              "type": "string",
              "enum": [
                "memory",
                "postgres"
              ],
              "description": "Embedded datastore",
              "default": "memory"
            },
            "datastore_uri": {
              "type": "string",
              "description": "Connection string of the embedded postgres datastore (supports env var expansion)"
            },
            "endpoint": {
              "type": "string",
              "description": "gRPC address of a remote SpiceDB"
            },
            "token": {
              "type": "string",
              "description": "Preshared key of a remote SpiceDB (supports env var expansion)"
            },
            "insecure": {
              "type": "boolean",
              "description": "Development only: connect to a remote SpiceDB without TLS",
              "default": false
            },
            "write_schema": {
              "type": "boolean",
              "description": "Write the composed schema to a remote SpiceDB at startup",
              "default": false
            }
          },
          "additionalProperties": false,
          "type": "object",
          "description": "SpiceDB engine settings for mode rebac"
        },
        "reconcile": {
          "properties": {
            "disabled": {
              "type": "boolean",
              "description": "Turn the graph reconciler off",
              "default": false
            },
            "skip_startup": {
              "type": "boolean",
              "description": "Do not reconcile at startup",
              "default": false
            },
            "interval": {
              "type": "string",
              "description": "Time between periodic reconciliations (Go duration; 0 for startup only)",
              "default": "15m"
            },
            "jitter": {
              "type": "string",
              "description": "Most added at random to each interval (Go duration; default a tenth of the interval)"
            },
            "page_size": {
              "type": "integer",
              "minimum": 0,
              "description": "Rows or relationships read per request",
              "default": 500
            }
          },
          "additionalProperties": false,
          "type": "object",
          "description": "Repair of the relationship graph from the identity tables in mode rebac"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Authorization mode and relationship engine"
    },
    "managed_principals": {
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Allow managed principals in this deployment"
        },
        "login_token_ttl": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Default lifetime of reusable login tokens",
          "default": "720h",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        },
        "login_token_max_ttl": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Maximum lifetime of any login token",
          "default": "9600h",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        },
        "single_use_token_ttl": {
          "type": "string",
          "pattern": "^(\\d+(\\.\\d+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Default lifetime of single-use login tokens",
          "default": "20m",
          "examples": [
            "15m",
            "1h",
            "168h",
            "720h"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Managed principal configuration (humans without an email)"
    },
    "connections": {
      "properties": {
        "keys_dir": {
          "type": "string",
          "description": "Directory holding the key ring and its registry"
        },
        "vault": {
          "type": "string",
          "description": "omnivault URI of the deployment secret store such as env:// or file:///dir"
        },
        "root_key": {
          "type": "string",
          "description": "Path in the vault of the key ring's 32-byte root key"
        },
        "allow_private_egress": {
          "type": "boolean",
          "description": "Development only: allow provider requests to private addresses and plain HTTP"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "keys_dir",
        "vault",
        "root_key"
      ],
      "description": "Connections to external services (ADR-017)"
    },
    "console": {
      "properties": {
        "web_dir": {
          "type": "string",
          "description": "Directory of the console's built pages; empty serves only its API"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Organization console under /console (ADR-018)"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "issuer"
  ],
  "title": "SystemAuth Configuration",
  "description": "Configuration schema for SystemAuth OAuth 2.0 / OpenID Connect server"
}